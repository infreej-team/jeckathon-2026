# Copy to .env and fill in real values. Never commit .env.

# ===== Deploy =====
COMPOSE_PROJECT_NAME=jeckathon
REGISTRY=ghcr.io/infreej-team
IMAGE_TAG=latest
DOMAIN=jeckathon.infreej.dev

# ===== Images =====
# Leave unset to use the placeholder image (traefik/whoami)
# CLIENT_IMAGE=${REGISTRY}/client:${IMAGE_TAG}
# SERVER_IMAGE=${REGISTRY}/server:${IMAGE_TAG}

# ===== Database (profile: db, MySQL) =====
DB_NAME=jeckathon
DB_USER=jeckathon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
