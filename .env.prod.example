# 운영 서버용 환경 변수 예시다. 서버에서 .env.prod로 복사한 뒤 실제 값을 채운다. .env.prod는 커밋하지 않는다.
# 사용법: docker compose -f compose.prod.yaml --env-file .env.prod up -d

# ===== 배포 =====
COMPOSE_PROJECT_NAME=jeckathon
REGISTRY=ghcr.io/infreej-team/jeckathon-2026
# 롤백할 때는 이전 커밋의 태그(sha-<7자리 커밋 SHA>)로 바꾼 뒤 pull과 up -d를 다시 실행한다.
# 롤백 대상은 Actions 실행이 모두 성공한 커밋으로 고른다.
IMAGE_TAG=latest
DOMAIN=jeckathon.infreej.dev

# ===== 이미지 =====
NGINX_IMAGE=${REGISTRY}/nginx:${IMAGE_TAG}
CLIENT_IMAGE=${REGISTRY}/client:${IMAGE_TAG}
SERVER_IMAGE=${REGISTRY}/server:${IMAGE_TAG}

# ===== 데이터베이스 (PostgreSQL) =====
# 비밀번호는 영숫자로만 만든다. $가 들어가면 변수로 해석되어 값이 바뀐다.
DB_NAME=jeckathon
DB_USER=jeckathon
DB_PASSWORD=change-me

# ===== 웹소켓 =====
# /api/ws 접속을 허용할 Origin. 쉼표로 여러 개를 넣는다.
WS_ALLOWED_ORIGINS=https://jeckathon.infreej.dev
